rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with the link can read and write the three collections the site uses.
    // The field checks keep stray data out; they do not stop a determined vandal.
    match /albums/{id} {
      allow read: if true;
      allow write: if request.resource == null || (
        request.resource.data.keys().hasOnly(['title','artist','year','status','date','suggestedBy','addedAt','addedBy','cover','itunesId'])
        && request.resource.data.title is string && request.resource.data.title.size() < 200);
    }
    match /logs/{id} {
      allow read: if true;
      allow write: if request.resource == null || (
        request.resource.data.keys().hasOnly(['albumId','person','rating','favorites','note','at'])
        && request.resource.data.favorites.size() < 60);
    }
    match /ranks/{id} {
      allow read: if true;
      allow write: if request.resource == null || (
        request.resource.data.keys().hasOnly(['name','order'])
        && request.resource.data.order.size() < 2000);
    }
  }
}
